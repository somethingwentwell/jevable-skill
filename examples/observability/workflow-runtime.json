    {
      "id": 23,
      "type": "timeseries",
      "title": "Last exporter failure category",
      "description": "None means no retained last failure, not proof of backend retention.",
      "gridPos": {
        "x": 0,
        "y": 69,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
