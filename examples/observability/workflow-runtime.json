{
  "id": null,
  "uid": "jevable-workflow-runtime",
  "title": "Jevable workflow runtime",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "jevable",
    "workflow-runtime",
    "development"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(jevable_retained_available, service_name)",
        "definition": "label_values(jevable_retained_available, service_name)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(jevable_retained_available{service_name=~\"${service:regex}\"}, deployment_environment_name)",
        "definition": "label_values(jevable_retained_available{service_name=~\"${service:regex}\"}, deployment_environment_name)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "instance",
        "label": "Runtime instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(jevable_retained_available{service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\"}, service_instance_id)",
        "definition": "label_values(jevable_retained_available{service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\"}, service_instance_id)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Jevable workflow runtime — diagnostic evidence",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Select **one service, environment and runtime instance**. A new owner gets a new instance ID; do not sum retained checkpoints across old and new owners. This dashboard observes active segments, not unique runs or business completion. **No data means unknown**, not healthy or zero. Backlog/approval panels require a complete projection received within 30 seconds. HTTP 200 does not prove workflow success. Local development profile; review thresholds before production use."
      }
    },
    {
      "id": 2,
      "title": "Evidence freshness and retained work",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Retained projection available (fresh only)",
      "description": "Only complete retained projections with a sample less than 30 seconds old. Missing/unavailable data is not zero.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data — unknown",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jevable:retained_available:fresh{service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\"}",
          "legendFormat": "available",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Seconds since last retained-state sample",
      "description": "Observation freshness, not receiver availability or complete delivery. An empty result is unknown.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data — unknown",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - timestamp(jevable_retained_available{service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\"})",
          "legendFormat": "sample age",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Retained checkpoints by state",
