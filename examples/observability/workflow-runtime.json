    {
      "id": 24,
      "type": "timeseries",
      "title": "Receiver acknowledgement age",
      "description": "No acknowledgement (zero) is omitted as unknown. Inactive trace/log pipelines may legitimately have old acknowledgements.",
      "gridPos": {
        "x": 12,
        "y": 69,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
