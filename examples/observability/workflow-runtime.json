      "targets": [
        {
          "refId": "A",
          "expr": "(jevable_retained_runs{service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\"}) and on (service_name, service_instance_id, deployment_environment_name) jevable:retained_available:fresh{service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\"}",
          "legendFormat": "{{jevable_retained_state}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
