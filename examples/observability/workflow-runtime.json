      "targets": [
        {
          "refId": "A",
          "expr": "jevable_telemetry_last_failure{service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\"} == 1",
          "legendFormat": "{{jevable_telemetry_signal}} · {{jevable_telemetry_state}}",
          "range": true,
