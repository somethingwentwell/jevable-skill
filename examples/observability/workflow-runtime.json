      "id": 19,
      "type": "timeseries",
      "title": "HTTP request observations / second",
      "description": "Requires httpRequests. Counts API traffic, not committed workflow operations.",
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data — unknown",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (jevable_http_status_class, jevable_http_outcome) (rate(jevable_http_requests{service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{jevable_http_status_class}} · {{jevable_http_outcome}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "HTTP handler/response duration p95",
      "description": "Waits for handler and response settlement, including work after disconnect. Not client receipt.",
      "gridPos": {
        "x": 12,
        "y": 55,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data — unknown",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(jevable_http_duration_bucket{service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\"}[$__rate_interval])))",
          "legendFormat": "{{jevable_outcome}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Dropped / rejected telemetry items",
      "description": "Process-local counters. A failed metrics receiver cannot report its own loss until delivery recovers.",
      "gridPos": {
        "x": 0,
        "y": 62,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data — unknown",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (jevable_telemetry_signal, jevable_telemetry_state) (increase(jevable_telemetry_records{service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\",jevable_telemetry_state=~\"dropped|rejected\"}[$__rate_interval]))",
          "legendFormat": "{{jevable_telemetry_signal}} · {{jevable_telemetry_state}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Queued / in-flight telemetry items",
