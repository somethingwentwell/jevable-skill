{
  "name": "Ticket triage",
  "nodes": [
    { "id": "1", "name": "When clicking Test workflow", "type": "n8n-nodes-base.manualTrigger", "typeVersion": 1, "parameters": {} },
    { "id": "2", "name": "Is urgent?", "type": "n8n-nodes-base.if", "typeVersion": 2, "parameters": { "conditions": {
      "combinator": "and", "conditions": [
        { "leftValue": "={{ $json.priority }}", "rightValue": "high", "operator": { "type": "string", "operation": "equals" } },
        { "leftValue": "={{ $json.open }}", "operator": { "type": "boolean", "operation": "true" } }
      ] } } },
    { "id": "3", "name": "Route by team", "type": "n8n-nodes-base.switch", "typeVersion": 3, "parameters": { "rules": { "values": [
      { "conditions": { "conditions": [ { "leftValue": "={{ $('When clicking Test workflow').item.json.team }}", "rightValue": "billing",
        "operator": { "type": "string", "operation": "equals" } } ] } },
      { "conditions": { "conditions": [ { "leftValue": "={{ $('When clicking Test workflow').item.json.team }}", "rightValue": "tech",
        "operator": { "type": "string", "operation": "equals" } } ] } }
    ] } } }
  ],
  "connections": {
    "When clicking Test workflow": { "main": [[ { "node": "Is urgent?", "type": "main", "index": 0 } ]] },
    "Is urgent?": { "main": [[ { "node": "Route by team", "type": "main", "index": 0 } ], []] }
  }
}
